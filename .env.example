# Copy this file to .env and fill in real values. Never commit .env to git.

# Get this free (no credit card required) from https://console.groq.com/keys
GROQ_API_KEY=

# Get this from a free Supabase Postgres project (see BACKEND-SETUP.md)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Any random string you choose — used to view submitted leads at
# /api/leads?key=YOUR_ADMIN_KEY without setting up a full login system
ADMIN_KEY=
